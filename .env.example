# Plantilla de configuración. Copia a .env.local (ignorado por git) para desarrollo.
#
# En producción NO se usa este archivo: los valores llegan desde los secretos del
# repositorio en GitHub (Settings → Secrets and variables → Actions):
#   UMAMI_WEBSITE_ID   →   VITE_UMAMI_WEBSITE_ID
#   UMAMI_SRC          →   VITE_UMAMI_SRC
#
# Si no hay valor, la web se compila sin ningún script de analítica.

# Id del sitio en Umami. Déjalo vacío para desarrollar sin enviar visitas.
VITE_UMAMI_WEBSITE_ID=

# Solo si te autoalojas Umami. Vacío = nube oficial (https://cloud.umami.is/script.js)
VITE_UMAMI_SRC=
